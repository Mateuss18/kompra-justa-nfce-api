{
  "name": "nfce-parser",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('lambda.zip',{force:true});\"",
    "build": "tsc",
    "zip": "powershell -NoProfile -Command \"if (Test-Path lambda.zip) { Remove-Item lambda.zip }; Compress-Archive -Path dist, node_modules, package.json -DestinationPath lambda.zip\"",
    "package": "npm run clean && npm run build && npm run zip",
    "test": "npm run build && node test/handler.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.14.0",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^20.19.43",
    "typescript": "^6.0.2"
  }
}
